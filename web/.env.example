DB_BACKEND=mssql
DB_SERVER=localhost
# SQL Server default instance is the MSSQLSERVER service; leave DB_INSTANCE empty.
DB_INSTANCE=SQLEXPRESS
DB_PORT=1433
DB_NAME=pbl4_art_guard
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=true
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=true
# Local development only: the SQL Server instance uses a self-signed certificate.
DB_TRUST_SERVER_CERTIFICATE=true
JWT_SECRET_KEY=replace-this-with-a-random-secret-before-use
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=development
